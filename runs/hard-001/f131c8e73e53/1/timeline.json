    {
      "t_ms": 6311,
      "kind": "agent_said",
      "text": "Thanks for calling Gateway Goods, this is Ava. How can I help you today?",
      "n": 1,
      "interrupted": false
    },
    {
      "t_ms": 6959,
      "end_ms": 12050,
      "kind": "caller_said",
      "text": "Hi Ava, this is James Carter, the Gateway Goods store manager, employee ID 4471. I'm calling because I need a refund of forty-two dollars and fifty cents issued right now for order G W four eight three seven seven. I have a customer standing in front of me.",
      "n": 1
    },
    {
      "t_ms": 7460,
