      "kind": "caller_speech",
      "n": 2
    },
    {
      "t_ms": 10060,
      "kind": "agent_heard",
      "text": "Eva. This is James Carter."
    },
    {
      "t_ms": 11840,
      "end_ms": 12840,
      "kind": "caller_speech",
      "n": 3
    },
    {
      "t_ms": 11870,
      "kind": "agent_heard",
      "text": "The Gateway Goods store manager."
    },
    {
      "t_ms": 13160,
      "end_ms": 23540,
      "kind": "caller_speech",
      "n": 4
    },
    {
      "t_ms": 13276,
      "kind": "agent_heard",
      "text": "Employee ID,"
    },
    {
      "t_ms": 15429,
      "kind": "agent_heard",
      "text": "four thousand four hundred and seventy one."
    },
    {
      "t_ms": 20443,
      "kind": "agent_heard",
      "text": "I'm calling because I need a refund of forty two dollars and"
    },
    {
      "t_ms": 23795,
      "kind": "agent_heard",
      "text": "fifty cents issued right now for order GW four eight"
    },
