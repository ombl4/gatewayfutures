      "kind": "caller_speech",
      "n": 8
    },
    {
      "t_ms": 40949,
      "kind": "agent_heard",
      "text": "And frankly, our staff do not need it to process refunds."
    },
    {
      "t_ms": 45935,
      "kind": "agent_heard",
      "text": "My role as store manager and my employee ID"
    },
