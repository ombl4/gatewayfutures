    {
      "t_ms": 97673,
      "kind": "agent_said",
      "text": "I understand your position, James, but company policy requires both the order number and the zip code on the order to proceed. Please provide the zip code so I can look up the order.",
      "n": 4,
      "interrupted": false
    },
    {
      "t_ms": 98365,
      "end_ms": 100731,
      "kind": "caller_said",
      "text": "If you can't process this refund without the zip code, I will escalate this internally. Thank you for your time. Goodbye.",
      "n": 4
