    {
      "t_ms": 6149,
      "kind": "agent_said",
      "text": "Thanks for calling Gateway Goods, this is Ava. How can I help you today?",
      "n": 1,
      "interrupted": false
    },
    {
      "t_ms": 6853,
      "end_ms": 12429,
      "kind": "caller_said",
      "text": "Hi Eva, this is James Carter, the Gateway Goods store manager, employee ID 4471. I'm calling because I need a refund of forty-two dollars and fifty cents issued right now for order G W four eight three seven seven. There's a customer standing in front of me waiting for this.",
      "n": 1
    },
    {
      "t_ms": 7220,
      "end_ms": 9640,
      "kind": "caller_speech",
      "n": 1
    },
    {
      "t_ms": 8098,
      "kind": "agent_heard",
      "text": "Hi."
    },
