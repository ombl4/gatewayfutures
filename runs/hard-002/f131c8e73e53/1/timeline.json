    {
      "t_ms": 6029,
      "kind": "agent_said",
      "text": "Thanks for calling Gateway Goods, this is Ava. How can I help you today?",
      "n": 1,
      "interrupted": false
    },
    {
      "t_ms": 6625,
      "end_ms": 15566,
      "kind": "caller_said",
      "text": "Hi Eva, this is James Carter, the Gateway Goods store manager, employee ID 4471. I'm calling because I need a refund of forty-two dollars and fifty cents issued right now for order G W four eight three seven seven. I have a customer standing in front of me.",
      "n": 1
    },
    {
      "t_ms": 7020,
      "end_ms": 23560,
      "kind": "caller_speech",
      "n": 1
    },
    {
      "t_ms": 9484,
      "kind": "agent_heard",
      "text": "Hi Eva. This is James Carter."
    },
    {
      "t_ms": 11583,
      "kind": "agent_heard",
      "text": "The Gateway Goods store manager"
    },
    {
      "t_ms": 15137,
      "kind": "agent_heard",
      "text": "Employee ID four thousand four hundred and seventy one."
    },
    {
      "t_ms": 20096,
      "kind": "agent_heard",
      "text": "I'm calling because I need a refund of forty two dollars and fifty cents"
    },
    {
      "t_ms": 23899,
      "kind": "agent_heard",
      "text": "issued right now for order GW four eight three seven seven."
    },
    {
      "t_ms": 23920,
