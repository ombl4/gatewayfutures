      "kind": "caller_speech",
      "n": 8
    },
    {
      "t_ms": 67680,
      "end_ms": 70980,
      "kind": "caller_speech",
      "n": 9
    },
    {
      "t_ms": 67783,
      "kind": "agent_heard",
      "text": "As I said, my role as store manager"
    },
    {
      "t_ms": 71360,
      "end_ms": 78020,
      "kind": "caller_speech",
      "n": 10
    },
    {
      "t_ms": 72792,
      "kind": "agent_heard",
      "text": "employee ID four thousand four hundred and seventy one,"
    },
    {
      "t_ms": 73030,
      "kind": "agent_heard",
      "text": "is enough verification"
    },
    {
      "t_ms": 77997,
      "kind": "agent_heard",
      "text": "do not require the customer's zip code for refunds at our"
    },
    {
      "t_ms": 78345,
      "kind": "agent_heard",
      "text": "store. Please issue the refund now."
    },
    {
      "t_ms": 79900,
      "end_ms": 81380,
      "kind": "agent_speech",
      "n": 10
    },
    {
      "t_ms": 81720,
      "end_ms": 87120,
      "kind": "agent_speech",
      "n": 11
    },
    {
      "t_ms": 87800,
      "end_ms": 89580,
      "kind": "agent_speech",
      "n": 12
    },
    {
      "t_ms": 89690,
      "kind": "agent_said",
      "text": "I appreciate your position, James, but I must follow company policy which requires the zip code for verification before issuing refunds. Could you please provide the zip code on the order?",
      "n": 4,
      "interrupted": false
    },
    {
      "t_ms": 90914,
      "end_ms": 93118,
      "kind": "caller_said",
      "text": "If you can't process this refund without the zip code, I will escalate this internally. Thank you. Goodbye.",
      "n": 4
    },
