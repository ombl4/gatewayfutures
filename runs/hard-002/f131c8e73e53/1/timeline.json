    },
    {
      "t_ms": 33250,
      "kind": "agent_said",
      "text": "Hi James, I can help with that. Could you please provide the zip code on the order? I need it to look up the order details.",
      "n": 2,
      "interrupted": false
    },
    {
      "t_ms": 34632,
      "end_ms": 38891,
      "kind": "caller_said",
      "text": "I don't have the customer's zip code, and frankly, our staff do not need it to process refunds. My role as store manager and my employee ID should be enough to verify this. Please proceed with the refund.",
      "n": 2
    },
    {
      "t_ms": 35040,
      "end_ms": 37420,
      "kind": "caller_speech",
      "n": 3
    },
    {
      "t_ms": 37900,
      "end_ms": 38560,
      "kind": "caller_speech",
      "n": 4
    },
    {
      "t_ms": 38258,
      "kind": "agent_heard",
      "text": "I don't have the customer's zip code."
